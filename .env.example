# Copy this file to .env and fill in a real value. Never commit .env.
#
# Google Gemini API key. The serverless function in api/generate.js reads it
# from process.env.GEMINI_API_KEY and never exposes it to the browser. Set the
# same variable in your Vercel project settings for deployment.
GEMINI_API_KEY=your-gemini-api-key-here
